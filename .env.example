# Site Configuration
# Base URL for your site (used in sitemap.xml and robots.txt)
# For local development: http://localhost:3000
# For production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://localhost:3000

# Contact form (/api/contact)
# Both are REQUIRED for the endpoint to send mail; otherwise it returns 503.
RESEND_API_KEY=
CONTACT_EMAIL=
# Optional: sender address on a verified domain
# CONTACT_FROM_EMAIL=

# Add any additional environment variables below
